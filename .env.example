# Demo mode is automatic when Supabase URL/key are unset.
# Set ATTENDANCE_DEMO_MODE=false when using a real Supabase project.
ATTENDANCE_DEMO_MODE=true

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used to sign rotating QR tokens (required in production)
QR_HMAC_SECRET=change-me-to-a-long-random-string

# Demo-mode staff session signing
SESSION_SECRET=change-me-session-secret
